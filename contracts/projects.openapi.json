{
  "openapi": "3.1.0",
  "info": {
    "title": "Project CLI contract",
    "version": "1.0.0",
    "description": "Mounted project create, state read, transition, and state advance routes. Request objects with undocumented DTOs are explicitly open."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/vibe/projects": {
      "post": {
        "operationId": "projectCreate",
        "summary": "Create a project",
        "responses": {
          "201": {
            "description": "Observed handler response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Handler decodes an arbitrary object and overwrites organisationId from verified identity.",
                "properties": {},
                "additionalProperties": true
              }
            }
          }
        }
      },
      "get": {
        "operationId": "projectList",
        "summary": "List projects",
        "responses": {
          "200": {
            "description": "Observed handler response"
          }
        }
      }
    },
    "/vibe/projects/{projectId}/state": {
      "get": {
        "operationId": "projectStateRead",
        "summary": "Read project state",
        "responses": {
          "200": {
            "description": "Observed handler response"
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/vibe/projects/{projectId}/transitions": {
      "post": {
        "operationId": "projectTransition",
        "summary": "Submit a project transition",
        "responses": {
          "200": {
            "description": "Observed handler response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Transition request DTO is not established by the route contract.",
                "properties": {},
                "additionalProperties": true
              }
            }
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/vibe/projects/{projectId}/state/advance": {
      "post": {
        "operationId": "projectStateAdvance",
        "summary": "Advance project state",
        "responses": {
          "200": {
            "description": "Observed handler response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Advance request DTO is not established by the route contract.",
                "properties": {},
                "additionalProperties": true
              }
            }
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {}
  }
}

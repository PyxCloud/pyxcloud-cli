{
  "openapi": "3.1.0",
  "info": {
    "title": "Project CLI contract",
    "version": "1.0.0",
    "description": "Mounted project create/list/detail routes, legacy Vibe state routes, and canonical state-machine routes. Request objects with undocumented DTOs are explicitly open."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/vibe/projects": {
      "post": {
        "operationId": "projectCreate",
        "summary": "Create a project",
        "responses": {
          "201": {
            "description": "Observed handler response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Project creation: name is required; description is optional. The server derives organisationId from authenticated identity.",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "additionalProperties": true,
                "required": [
                  "name"
                ],
                "example": {
                  "name": "My project",
                  "description": "Repository analysis and work plan"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "projectList",
        "summary": "List projects",
        "responses": {
          "200": {
            "description": "Observed handler response"
          }
        }
      }
    },
    "/vibe/projects/{projectId}/state": {
      "get": {
        "operationId": "projectStateRead",
        "summary": "Read project state",
        "responses": {
          "200": {
            "description": "Observed handler response"
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/vibe/projects/{projectId}/transitions": {
      "post": {
        "operationId": "projectTransition",
        "summary": "Submit a project transition",
        "responses": {
          "200": {
            "description": "Observed handler response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Transition request DTO is not established by the route contract.",
                "properties": {},
                "additionalProperties": true
              }
            }
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/vibe/projects/{projectId}/state/advance": {
      "post": {
        "operationId": "projectStateAdvance",
        "summary": "Advance project state",
        "responses": {
          "200": {
            "description": "Observed handler response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Advance request DTO is not established by the route contract.",
                "properties": {},
                "additionalProperties": true
              }
            }
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/vibe/projects/{projectId}": {
      "get": {
        "operationId": "projectRead",
        "summary": "Read a project",
        "responses": {
          "200": {
            "description": "Observed handler response"
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/projects/{projectId}/state": {
      "get": {
        "operationId": "canonicalProjectStateRead",
        "summary": "Read canonical project state",
        "responses": {
          "200": {
            "description": "Canonical state snapshot including data, version, and events"
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/projects/{projectId}/transitions": {
      "post": {
        "operationId": "canonicalProjectTransition",
        "summary": "Apply a canonical project transition",
        "responses": {
          "200": {
            "description": "Observed canonical state snapshot"
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "version": {
                    "type": "integer"
                  }
                },
                "required": [
                  "event"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}

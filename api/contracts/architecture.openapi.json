{
  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "error": {
            "description": "stable typed error code (ARCH-*)",
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ArchitectureCompletion": {
        "properties": {
          "documentation": {
            "$ref": "#/components/schemas/DocumentationDeploymentSnapshot"
          },
          "functionalScope": {
            "description": "immutable functional scope preserved verbatim from the frozen snapshot",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "nextRoute": {
            "description": "present ONLY for a backend-confirmed FROZEN_COMPLETE snapshot; the architecture.selected event and selection never carry it",
            "oneOf": [
              {
                "$ref": "#/components/schemas/NextRouteCapability"
              },
              {
                "type": "null"
              }
            ]
          },
          "projectId": {
            "format": "int64",
            "type": "integer"
          },
          "projectVersionId": {
            "format": "int64",
            "type": "integer"
          },
          "requirements": {
            "description": "immutable requirements preserved verbatim from the frozen snapshot",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "revisionId": {
            "description": "published canonical architecture revision",
            "type": "string"
          },
          "selectionId": {
            "description": "identifies the selected architecture revision",
            "type": "string"
          },
          "state": {
            "description": "FINALIZING and FAILED are retryable",
            "enum": [
              "PENDING",
              "FINALIZING",
              "COMPLETED",
              "FAILED"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "ArchitectureRead": {
        "properties": {
          "completion": {
            "description": "version-bound completion state; distinct observable from the selection, same projectVersionId",
            "oneOf": [
              {
                "$ref": "#/components/schemas/ArchitectureCompletion"
              },
              {
                "type": "null"
              }
            ]
          },
          "freshness": {
            "type": "string"
          },
          "lastRun": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GenerationRun"
              },
              {
                "type": "null"
              }
            ]
          },
          "priorArchitectureRevisionId": {
            "description": "revisionId of the most recent CONFIRMED (selected) revision of an earlier project version of this project/org; null when none exists",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "projectId": {
            "format": "int64",
            "type": "integer"
          },
          "projectVersionId": {
            "format": "int64",
            "type": "integer"
          },
          "selection": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SelectionResult"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "DocumentationDeploymentSnapshot": {
        "properties": {
          "completedAt": {
            "description": "backend confirmation timestamp; required exactly on FROZEN_COMPLETE",
            "format": "date-time",
            "type": "string"
          },
          "projectVersionId": {
            "description": "same version pin as the architecture selection",
            "format": "int64",
            "type": "integer"
          },
          "snapshotId": {
            "description": "id of the frozen documentation snapshot serving this version; never a detached derived revision",
            "type": "string"
          },
          "state": {
            "enum": [
              "LOCKED_PENDING_ARCHITECTURE",
              "FROZEN_COMPLETE"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "GenerationRefusal": {
        "properties": {
          "code": {
            "description": "closed archcatalog refusal vocabulary",
            "type": "string"
          },
          "component": {
            "description": "component key (relation: its from end); absent for a topology-level refusal",
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "kind": {
            "description": "the catalogue kind involved, when there is one",
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "GenerationRequest": {
        "properties": {
          "expectedVersion": {
            "description": "optimistic-concurrency pin",
            "format": "int64",
            "type": "integer"
          },
          "idempotencyKey": {
            "description": "caller-chosen; replay returns the existing run",
            "type": "string"
          },
          "optimizationObjective": {
            "enum": [
              "LOWEST_COST",
              "BALANCED",
              "LOW_LATENCY"
            ],
            "type": "string"
          },
          "projectVersionId": {
            "description": "pinned frozen project version",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "GenerationRun": {
        "properties": {
          "etaSeconds": {
            "description": "backend-produced projection; absent means unknown",
            "type": "integer"
          },
          "evidenceManifestHash": {
            "type": "string"
          },
          "freshness": {
            "enum": [
              "FRESH",
              "STALE",
              "DEGRADED"
            ],
            "type": "string"
          },
          "generationId": {
            "type": "string"
          },
          "generatorVersion": {
            "type": "string"
          },
          "optimizationObjective": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "PENDING",
              "ASSEMBLING",
              "GENERATING",
              "ESTIMATING",
              "RANKING",
              "VALIDATING",
              "COMPLETED",
              "FAILED"
            ],
            "type": "string"
          },
          "progress": {
            "type": "integer"
          },
          "projectId": {
            "format": "int64",
            "type": "integer"
          },
          "projectVersionId": {
            "format": "int64",
            "type": "integer"
          },
          "proposals": {
            "description": "1..3 proposals, exactly one recommended",
            "items": {
              "$ref": "#/components/schemas/Proposal"
            },
            "type": "array"
          },
          "refusals": {
            "description": "ARC-02.3 per-item refusals of a FAILED run (why a candidate cannot be hosted); absent otherwise",
            "items": {
              "$ref": "#/components/schemas/GenerationRefusal"
            },
            "type": "array"
          },
          "state": {
            "enum": [
              "PENDING",
              "RUNNING",
              "COMPLETED",
              "FAILED"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "MetricInterval": {
        "properties": {
          "basis": {
            "type": "string"
          },
          "calculationVersion": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "coverage": {
            "type": "number"
          },
          "currency": {
            "description": "required for monetary kinds",
            "type": "string"
          },
          "kind": {
            "enum": [
              "OPEX",
              "IMPLEMENTATION_COST",
              "LATENCY",
              "RELIABILITY",
              "COMPLEXITY"
            ],
            "type": "string"
          },
          "max": {
            "description": "absent means unknown",
            "type": "number"
          },
          "min": {
            "description": "absent means unknown",
            "type": "number"
          },
          "period": {
            "enum": [
              "MONTHLY",
              "ONE_TIME",
              "NONE"
            ],
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "NFR": {
        "properties": {
          "assertion": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "NextRouteCapability": {
        "properties": {
          "confirmedAt": {
            "description": "backend FROZEN_COMPLETE confirmation",
            "format": "date-time",
            "type": "string"
          },
          "route": {
            "description": "provider/region next step (Region Compare surface)",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Proposal": {
        "properties": {
          "confidence": {
            "type": "number"
          },
          "coverage": {
            "type": "number"
          },
          "coverageBasis": {
            "type": "string"
          },
          "generationId": {
            "type": "string"
          },
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/MetricInterval"
            },
            "type": "array"
          },
          "nfrs": {
            "items": {
              "$ref": "#/components/schemas/NFR"
            },
            "type": "array"
          },
          "proposalId": {
            "type": "string"
          },
          "provenance": {
            "$ref": "#/components/schemas/ProposalProvenance"
          },
          "rank": {
            "description": "dense 1-based",
            "type": "integer"
          },
          "recommended": {
            "description": "true for exactly one proposal; it is preselected",
            "type": "boolean"
          },
          "revisionId": {
            "description": "persisted canonical revision this proposal was generated from; not implicitly selected/published",
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "topology": {
            "$ref": "#/components/schemas/TopologyDocument"
          },
          "tradeOffs": {
            "items": {
              "$ref": "#/components/schemas/TradeOff"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ProposalProvenance": {
        "properties": {
          "evidenceManifestHash": {
            "type": "string"
          },
          "generationId": {
            "type": "string"
          },
          "generatorVersion": {
            "type": "string"
          },
          "securityGateDecisionId": {
            "description": "current GO decision reference (backend #1327); opaque",
            "type": "string"
          },
          "sourceVersionPin": {
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "SelectionCommand": {
        "properties": {
          "environments": {
            "description": "ENV-01.3: environment kinds this confirm ensures; omitted/empty defaults to production only, staging is an additional toggle. These are fixed by whichever confirm WINS the version (first successful publish, including winning a concurrent race): a replay (same generationId/proposalId/idempotencyKey) returns the original response and never re-ensures, even if this field differs from the winning confirm's. Changing the environment set of an already-selected version is not supported yet — a second confirm for that version, with any idempotencyKey, is refused (409, already selected); it does not create or add an environment. Environment rows are per PROJECT, not per version, and accumulate: once staging exists for a project, confirming a LATER version with staging omitted does not remove it — omitting the field only means \"don't add anything new\", never \"remove what's there\".",
            "items": {
              "enum": [
                "production",
                "staging"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "expectedVersion": {
            "format": "int64",
            "type": "integer"
          },
          "generationId": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "proposalId": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "SelectionResult": {
        "properties": {
          "generationId": {
            "type": "string"
          },
          "projectId": {
            "format": "int64",
            "type": "integer"
          },
          "projectVersionId": {
            "format": "int64",
            "type": "integer"
          },
          "proposalId": {
            "type": "string"
          },
          "revisionId": {
            "description": "published canonical architecture revision",
            "type": "string"
          },
          "selectedAt": {
            "format": "date-time",
            "type": "string"
          },
          "selectionId": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TopologyDocument": {
        "properties": {
          "content": {
            "description": "rendered verbatim by the read-only vendor canvas; never editable",
            "type": "object"
          },
          "format": {
            "description": "canonical topology format pinned by the topology compiler (#1394)",
            "type": "string"
          },
          "schemaVersion": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TradeOff": {
        "properties": {
          "kind": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "REST face of the canonical Architecture aggregate (epic #1386). Architecture is a choice page, not an editor: the user selects one generated proposal; there is no manual or prompt-based topology editing. Estimates are provider/region-neutral; provider and region choice belongs to the later passo_cloud stage.",
    "title": "passo.build architecture API",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/vibe/projects/{projectId}/architecture": {
      "get": {
        "operationId": "getArchitecture",
        "parameters": [
          {
            "description": "project id (must belong to the caller's organisation; 404 otherwise)",
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ArchitectureRead"
                  }
                }
              },
              "description": "current read model"
            }
          },
          "404": {
            "404": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              },
              "description": "project not found"
            }
          }
        },
        "summary": "Current architecture read model: last generation and published selection"
      }
    },
    "/vibe/projects/{projectId}/architecture/generations": {
      "post": {
        "operationId": "createArchitectureGeneration",
        "parameters": [
          {
            "description": "project id (must belong to the caller's organisation; 404 otherwise)",
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/GenerationRun"
                  }
                }
              },
              "description": "existing run replayed by idempotencyKey"
            }
          },
          "202": {
            "202": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/GenerationRun"
                  }
                }
              },
              "description": "new generation accepted"
            }
          },
          "409": {
            "409": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              },
              "description": "stale version / unlocked version / already selected / another generation running"
            }
          },
          "422": {
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              },
              "description": "security decision absent or not GO"
            }
          }
        },
        "summary": "Start (or replay) one idempotent generation for the pinned frozen version"
      }
    },
    "/vibe/projects/{projectId}/architecture/generations/{generationId}": {
      "get": {
        "operationId": "getArchitectureGeneration",
        "parameters": [
          {
            "description": "project id (must belong to the caller's organisation; 404 otherwise)",
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "generationId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/GenerationRun"
                  }
                }
              },
              "description": "the run"
            }
          },
          "404": {
            "404": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              },
              "description": "run not found"
            }
          }
        },
        "summary": "One durable generation run with its proposals"
      }
    },
    "/vibe/projects/{projectId}/architecture/proposals/{proposalId}": {
      "get": {
        "operationId": "getArchitectureProposal",
        "parameters": [
          {
            "description": "project id (must belong to the caller's organisation; 404 otherwise)",
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "proposalId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Proposal"
                  }
                }
              },
              "description": "the proposal"
            }
          },
          "404": {
            "404": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              },
              "description": "proposal not found or foreign"
            }
          }
        },
        "summary": "One immutable proposal with topology, trade-offs, NFRs and estimate intervals"
      }
    },
    "/vibe/projects/{projectId}/architecture/selections": {
      "post": {
        "operationId": "createArchitectureSelection",
        "parameters": [
          {
            "description": "project id (must belong to the caller's organisation; 404 otherwise)",
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/SelectionResult"
                  }
                }
              },
              "description": "existing selection replayed by idempotencyKey"
            }
          },
          "201": {
            "201": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/SelectionResult"
                  }
                }
              },
              "description": "selection published"
            }
          },
          "403": {
            "403": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              },
              "description": "proposal edit forbidden (there is no edit surface)"
            }
          },
          "409": {
            "409": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              },
              "description": "stale version / already selected / invalid or foreign proposal / incomplete estimates"
            }
          }
        },
        "summary": "Select one generated proposal; atomic and idempotent; publishes the architecture revision"
      }
    }
  }
}
